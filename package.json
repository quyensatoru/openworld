{
  "name": "office",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "db:migrate:remote": "wrangler d1 migrations apply office --remote",
    "check": "node scripts/check.mjs",
    "deploy": "npm run check && vite build && node scripts/deploy.mjs",
    "verify:prod": "node scripts/verify-deploy.mjs",
    "assets:inspect": "node scripts/inspect-assets.mjs",
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "test": "node scripts/smoke-test.mjs",
    "test:agents": "node scripts/agents-test.mjs",
    "test:runner": "node scripts/runner-test.mjs",
    "e2e": "node scripts/e2e.mjs",
    "assets:vrm": "node scripts/prepare-vrm.mjs assets-src/vrm public/models/vrm"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "meshoptimizer": "^1.3.0",
    "puppeteer-core": "^25.16.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "wrangler": "^4.156.1",
    "ws": "^8.22.1"
  }
}
