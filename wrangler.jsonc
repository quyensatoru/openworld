{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "office",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "OFFICE", "class_name": "OfficeRoom" }],
    // the office room must run the same build as the page (client and server share types/layout):
    // switch over at deploy instead of Cloudflare's default "keep old code up to 5 min while busy"
    "code_update_strategy": { "mode": "immediate" }
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OfficeRoom"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "office",
      "database_id": "3f951135-1c58-4b2b-a67e-cd49cbe14029",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "OFFICE_NAME": "Office",
    "TZ_OFFSET_MINUTES": "420",
    // Local hours when a "people are here" notification may go out.
    "PUSH_HOURS": "8-22",
    // Public half of the Web Push key pair — not a secret, the browser needs it to subscribe.
    // Generate with: node scripts/gen-vapid.mjs
    "VAPID_PUBLIC_KEY": "BGF__fngny89rUvmDYg75MnfJZ_fxriwlNCwHqNFlYZ5MEXmuVlKAAZ4fENhDF59phBs5gO07pAc-L8Cl26-dEs"
  },
  "observability": { "enabled": true }
}
